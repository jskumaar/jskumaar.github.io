<div class="col mb-4">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      <div class="card-body">
        <h3 class="card-title text-center">{{ project.title }}</h3>
        <div class="row no-gutters">
          {% if project.img %}
            <div class="col-6">
              <div class="card-img-wrap">
                {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 156px, 50vw" alt="project thumbnail" class="card-img" %}
                {% if project.github %}
                  <div class="github-icon" data-toggle="tooltip" title="Code Repository">
                    <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
                    {% if project.github_stars %}
                      <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                        <i class="fa-solid fa-star"></i>
                        <span id="{{ project.github_stars }}-stars"></span>
                      </span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
          <div class="{% if project.img %}col-6 pl-3{% else %}col-12{% endif %} d-flex flex-column">
            <p class="card-text">{{ project.description }}</p>
          </div>
        </div>
      </div>
    </div>
  </a>
</div>
